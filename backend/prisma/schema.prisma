// Q-PASS BITUNG - Prisma Schema
// Quality & Quantity Assurance Testimonial System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  PENGAWAS
  SPBU
  AMT
}

enum LOStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  COMPLETED
}

enum FeedbackStatus {
  NORMAL
  HIGH_PRIORITY
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SealCondition {
  UTUH
  RUSAK
}

enum VolumeStatus {
  SESUAI
  SELISIH
}

enum VisualCondition {
  JERNIH
  ADA_AIR
  ADA_ENDAPAN
}

// ============================================
// MODELS
// ============================================

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(PENGAWAS)
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  otpCode       String?
  otpExpiry     DateTime?
  lastLogin     DateTime?
  lastLoginLat  Float?
  lastLoginLng  Float?

  // Relations
  spbuId        Int?
  spbu          Spbu?        @relation(fields: [spbuId], references: [id])
  amtId         Int?
  complaints    Complaint[]  @relation("ResolvedBy")
  auditLogs     AuditLog[]
  notifications Notification[]
  qualityControls QualityControl[]
  vesselDischarges VesselDischarge[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Spbu {
  id            Int       @id @default(autoincrement())
  name          String
  code          String    @unique
  address       String
  city          String    @default("Bitung")
  region        String    @default("Sulawesi Utara")
  lat           Float
  lng           Float
  phone         String?
  ownerName     String?
  isActive      Boolean   @default(true)

  // Relations
  loadingOrders LoadingOrder[]
  feedbacks     Feedback[]
  amtFeedbacks  AMTFeedback[]
  users         User[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("spbus")
}

model Truck {
  id            Int       @id @default(autoincrement())
  nopol         String    @unique
  capacity      Float     @default(8000)
  type          String    @default("Tangki")
  isActive      Boolean   @default(true)

  // Relations
  loadingOrders LoadingOrder[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("trucks")
}

model Amt {
  id            Int       @id @default(autoincrement())
  name          String
  nip           String    @unique
  code          String    @unique
  phone         String?
  isActive      Boolean   @default(true)

  latestLat          Float?
  latestLng          Float?
  lastLocationUpdate DateTime?

  // Relations
  loadingOrders LoadingOrder[] @relation("PrimaryAmt")
  secondaryLoadingOrders LoadingOrder[] @relation("SecondaryAmt")
  amtFeedbacks  AMTFeedback[] @relation("RatedAmt")
  locationLogs  AmtLocationLog[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("amts")
}

model LoadingOrder {
  id            Int       @id @default(autoincrement())
  noLO          String    @unique
  product       String
  volume        Float
  date          DateTime  @default(now())
  status        LOStatus  @default(PENDING)
  qrCode        String?   @db.Text
  qrToken       String?   @unique @default(uuid())

  // Relations
  spbuId        Int
  spbu          Spbu      @relation(fields: [spbuId], references: [id])
  truckId       Int
  truck         Truck     @relation(fields: [truckId], references: [id])
  amtId         Int
  amt           Amt       @relation("PrimaryAmt", fields: [amtId], references: [id])
  secondaryAmtId Int?
  secondaryAmt  Amt?      @relation("SecondaryAmt", fields: [secondaryAmtId], references: [id])
  feedback      Feedback?
  amtFeedbacks  AMTFeedback[]
  locationLogs  AmtLocationLog[]
  qualityControls QualityControl[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("loading_orders")
}

model Feedback {
  id              Int             @id @default(autoincrement())
  
  // Loading Order reference
  loId            Int             @unique
  lo              LoadingOrder    @relation(fields: [loId], references: [id])

  // SPBU reference (denormalized for faster queries)
  spbuId          Int
  spbu            Spbu            @relation(fields: [spbuId], references: [id])

  // Quality & Quantity Data
  sealCondition   SealCondition
  volumeStatus    VolumeStatus
  volumeDiff      Float?          // Selisih volume in liters
  visualCondition VisualCondition
  density         Float           // kg/m³

  // Rating & Notes
  rating          Int             // 1-5
  notes           String?         @db.Text
  photoUrl        String?

  // Geotagging
  lat             Float?
  lng             Float?

  // Computed status
  status          FeedbackStatus  @default(NORMAL)

  // Timestamps
  submittedAt     DateTime        @default(now())

  // Relations
  complaint       Complaint?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("feedbacks")
}

model AMTFeedback {
  id              Int       @id @default(autoincrement())
  
  // AMT reference (who gave the rating)
  amtId           Int
  amt             Amt       @relation("RatedAmt", fields: [amtId], references: [id])

  // SPBU reference (who is being rated)
  spbuId          Int
  spbu            Spbu      @relation(fields: [spbuId], references: [id])

  // Loading Order reference
  loId            Int
  lo              LoadingOrder @relation(fields: [loId], references: [id])

  // Rating Data
  ratingKeramahan  Int       // 1-5 - Keramahan SPBU
  ratingKooperasi  Int       // 1-5 - Kerjasama SPBU
  ratingFasilitas  Int       // 1-5 - Fasilitas SPBU
  ratingProses     Int       // 1-5 - Proses bongkar muat
  ratingKeseluruhan Int      // 1-5 - Overall rating

  // Notes
  notes           String?   @db.Text
  photoUrl        String?

  // Geotagging
  lat             Float?
  lng             Float?

  // Timestamps
  submittedAt     DateTime  @default(now())

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([loId, amtId])
  @@map("amt_feedbacks")
}

model Complaint {
  id            Int             @id @default(autoincrement())
  feedbackId    Int             @unique
  feedback      Feedback        @relation(fields: [feedbackId], references: [id])
  description   String          @db.Text
  reasons       String          @db.Text // Comma-separated list of reason codes
  status        ComplaintStatus  @default(OPEN)
  
  resolvedById  Int?
  resolvedBy    User?           @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolvedNote  String?         @db.Text
  resolvedAt    DateTime?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("complaints")
}

model Notification {
  id            Int       @id @default(autoincrement())
  userId        Int?
  user          User?     @relation(fields: [userId], references: [id])
  
  title         String
  message       String    @db.Text
  type          String    @default("info") // info, warning, critical
  isRead        Boolean   @default(false)
  link          String?
  
  createdAt     DateTime  @default(now())

  @@map("notifications")
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  userId        Int?
  user          User?     @relation(fields: [userId], references: [id])
  
  action        String
  entity        String
  entityId      Int?
  details       String?   @db.Text
  ipAddress     String?

  createdAt     DateTime  @default(now())

  @@map("audit_logs")
}

model AmtLocationLog {
  id            Int           @id @default(autoincrement())
  amtId         Int
  amt           Amt           @relation(fields: [amtId], references: [id], onDelete: Cascade)
  loId          Int?
  lo            LoadingOrder? @relation(fields: [loId], references: [id], onDelete: SetNull)
  lat           Float
  lng           Float
  speed         Float?
  heading       Float?
  accuracy      Float?
  status        String?       @default("IN_TRANSIT")
  recordedAt    DateTime      @default(now())

  createdAt     DateTime      @default(now())

  @@map("amt_location_logs")
}

// ============================================
// QUALITY CONTROL ENUMS & MODEL
// ============================================

enum QualityControlStage {
  VESSEL_DISCHARGE   // Tahap 1: Discharge Kapal Tanker
  STORAGE_TANK       // Tahap 2: Tangki Timbun Terminal
  FILLING_SHED_TRUCK // Tahap 3: Mobil Tanki / Loading Order
}

enum QualityControlStatus {
  PASSED
  OFF_SPEC
  PENDING
  HOLD
}

model QualityControl {
  id              Int                  @id @default(autoincrement())
  stage           QualityControlStage  @default(VESSEL_DISCHARGE)
  product         String               // Pertalite, Pertamax, Biosolar, Dexlite, dll.
  batchNo         String?              // No. B/L, Batch, No. Tangki, No. LO
  sourceName      String               // Nama Kapal, No. Tangki Timbun, Nopol Mobil Tanki

  // Parameter Kualitas
  densityObserved Float?               // kg/m³ Observed
  temperature     Float?               // °C
  density15C      Float                // kg/m³ Standard 15°C
  visualCondition VisualCondition      @default(JERNIH)
  waterContent    Float?               // ppm or mm
  flashPoint      Float?               // °C (opsional)

  // Meta & Inspector
  sampleDate      DateTime             @default(now())
  inspectorName   String               // Inspector QQ / Admin
  notes           String?              @db.Text
  certificateUrl  String?              // File scan / dokumen
  status          QualityControlStatus @default(PASSED)
  isOffSpec       Boolean              @default(false)

  // Relations
  loId            Int?
  lo              LoadingOrder?        @relation(fields: [loId], references: [id], onDelete: SetNull)
  createdById     Int?
  createdBy       User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("quality_controls")
}

// ============================================
// CQD & VESSEL DISCHARGE MODELS
// ============================================

model VesselDischarge {
  id                    Int       @id @default(autoincrement())
  noLODischarge         String    @unique // No. LO Discharge / ID Kargo Discharge (e.g. LO-DISCH-20260826-001)
  vesselName            String    // Nama Kapal / Tongkang (e.g. BG. AME IX)
  loadedAt              String    // Pelabuhan Asal (e.g. PT. KUTAI REFINERY NUSANTARA/PSO)
  dischargeAt           String    @default("1419 Integrated Terminal Bitung")
  externalNo            String?   // External / BL Reference No
  bastNumber            String?   // No. BAST (e.g. 503)
  materialNo            String?   // Material No (e.g. A040900014/BIOFAME)
  poNumber              String?   // PO Number (e.g. 5250015489)
  product               String    // Product Name (BIOFAME, Pertalite, Biosolar, Dexlite)
  psoType               String?   @default("PSO") // PSO / Non-PSO
  cqdDate               DateTime  @default(now())
  cqdTime               String?   // Time string (e.g. 14.10.46)

  // Bill of Lading (B/L) Quantities
  blQuantityLitersObs   Float?    // Liters Obs
  blQuantityLiters15    Float?    // Liters @ 15°C (Main Pertamina Benchmark)
  blQuantityMetricTon   Float?    // Metric Ton
  blQuantityBarrels60F  Float?    // Barrels @ 60°F

  // Received In Shore Tank Quantities (Calculated or Sum of Tanks)
  totalReceivedLitersObs Float?
  totalReceivedLiters15  Float?
  totalReceivedMetricTon Float?

  // Shortage / Excess vs B/L
  shortageLitersObs     Float?
  shortageLiters15      Float?
  shortageMetricTon     Float?
  percentageVsBL        Float?    // % VS B/L (e.g. -0.967)
  isToleranceExceeded   Boolean   @default(false) // True if % VS B/L exceeds tolerance (e.g. < -0.5%)

  // Additional Details & Signatures
  remarks               String?   @db.Text
  loadingPort           String?   // Loading Port Signatory (e.g. PT KRN - Agung Priyadi)
  surveyorBy            String?   // Surveyor Signatory (e.g. PT TRS - Kamarudin)
  preparedBy            String?   // Spv Fuel Rec & Sto (e.g. Nasrul)
  checkedBy             String?   // Loading Master (e.g. Ujang Muhidin)
  acknowledgeBy         String?   // IT Manager Bitung (e.g. Arman Prastiono)

  // Creator & Relations
  createdById           Int?
  createdBy             User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tanks                 VesselDischargeTank[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("vessel_discharges")
}

model VesselDischargeTank {
  id                    Int             @id @default(autoincrement())
  vesselDischargeId     Int
  vesselDischarge       VesselDischarge @relation(fields: [vesselDischargeId], references: [id], onDelete: Cascade)

  tankNo                String          // No. Tangki Darat (e.g. Tank 5, Tank 8)
  indication            String          @default("NET") // AFTER, BEFORE, NET
  date                  DateTime?
  time                  String?         // Waktu (e.g. 04.46)

  // Shore Sample Data
  testDensity           Float?          // Test Dens
  testTemp              Float?          // Test Temp (°C)
  density15C            Float?          // Dens 15°C

  // Product in Shore Tank Measurements
  totalDip              Float?          // Total Dip (cm / mm)
  waterDip              Float?          @default(0) // Water Dip
  tempObs               Float?          // Temp Obs (°C)
  netProductObsL        Float?          // Net Product (Obs) Liters
  correction            Float?          // Correction Factor (e.g. 0.988276)
  liters15              Float?          // Liters @ 15°C
  longTonsPer1000L      Float?          // Long Tons per 1000 L
  longTons              Float?          // Long Tons
  barrels60F            Float?          // Barrels @ 60°F
  metricTon             Float?          // Metric Ton

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("vessel_discharge_tanks")
}


