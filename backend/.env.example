# ============================================
# Q-PASS BITUNG - Backend Environment
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL - Supabase or local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/qpass_bitung?schema=public"

# JWT
JWT_SECRET="qpass_bitung_super_secret_jwt_key_2026_change_this"
JWT_EXPIRES_IN="7d"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Email Notification (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
NOTIFY_EMAIL="pengawas@pertamina.com"

# WhatsApp (Fonnte API)
FONNTE_TOKEN=""
FONNTE_TARGET=""

# Upload
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=5242880

# QR Code Base URL (frontend URL for QR links)
QR_BASE_URL="http://localhost:5173/feedback"
